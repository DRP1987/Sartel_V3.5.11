{
  "sheets": [
    {
      "id": "standard",
      "name": "Standard Installation Sheet",
      "excel_file": "installation_sheet_standard.xlsx",
      "sheet_index": 0,
      "picture_anchor_cell": "A35",
      "checkbox_yes_char": "☑",
      "checkbox_no_char": "☐",
      "fields": [
        {"label": "Client / Company Name",  "cell": "B21", "type": "text", "required": true},
        {"label": "Site / Project Name",    "cell": "B22", "type": "text", "required": true},
        {"label": "Installation Date",      "cell": "B23", "type": "text", "required": true},
        {"label": "Technician Name",        "cell": "B24", "type": "text", "required": true},
        {"label": "Vehicle Type / Model",   "cell": "B25", "type": "text"},
        {"label": "Vehicle Serial Number",  "cell": "B26", "type": "text"},
        {"label": "Engine Type",            "cell": "B27", "type": "text"},
        {"label": "CAN Channel",            "cell": "B28", "type": "text"},
        {
          "label": "Note Baudrate",
          "cell": "B29",
          "type": "auto_fill",
          "auto_source": "baudrate"
        },
        {"label": "Software Version",       "cell": "B30", "type": "text"},
        {
          "label": "Note configuration selected",
          "cell": "B31",
          "type": "auto_fill",
          "auto_source": "config_name"
        },
        {"label": "Connection for Supplies", "type": "section_title"},
        {
          "label": "Is the crane control CanBus connected for LMB and Crane operation?",
          "type": "conditional",
          "required": true,
          "checkbox_cell": "B33",
          "yes_text_label": "Connection Details",
          "yes_text_cell": "B34",
          "yes_text_label2": "Additional Notes (Yes)",
          "yes_text_cell2": "B35",
          "no_text_label": "Reason for Non-Connection",
          "no_text_cell": "B36",
          "no_text_label2": "Additional Notes (No)",
          "no_text_cell2": "B37"
        },
        {"label": "Notes / Comments",       "cell": "B32", "type": "multiline"}
      ]
    },
    {
      "id": "vehicle_tracker",
      "name": "Vehicle Tracker Installation Sheet",
      "excel_file": "installation_sheet_vehicle_tracker.xlsx",
      "sheet_index": 0,
      "picture_anchor_cell": "A45",
      "checkbox_yes_char": "☑",
      "checkbox_no_char": "☐",
      "fields": [
        {"label": "Client / Company Name",  "cell": "B21", "type": "text", "required": true},
        {"label": "Installation Date",      "cell": "B22", "type": "text", "required": true},
        {"label": "Technician Name",        "cell": "B23", "type": "text", "required": true},
        {"label": "IMEI Number",            "cell": "AB21","type": "text", "required": true},
        {"label": "Vehicle Registration",   "cell": "B24", "type": "text"},
        {"label": "Vehicle Make / Model",   "cell": "B25", "type": "text"},
        {
          "label": "Note configuration selected",
          "cell": "B26",
          "type": "auto_fill",
          "auto_source": "config_name"
        },
        {
          "label": "Note Baudrate",
          "cell": "B27",
          "type": "auto_fill",
          "auto_source": "baudrate"
        },
        {"label": "Hardware Installation Checks", "type": "section_title"},
        {
          "label": "Hardware Installation Checks",
          "type": "checkbox_group",
          "group_id": "hw_checks",
          "options": [
            {
              "label": "GPS Antenna Installed",
              "cell": "C30",
              "sub_questions": [
                {"label": "Antenna Location",        "cell": "D30", "type": "text"},
                {"label": "Cable Routing Notes",     "cell": "E30", "type": "text"}
              ]
            },
            {
              "label": "CAN Bus Connected",
              "cell": "C31",
              "sub_questions": [
                {"label": "Connection Type",         "cell": "D31", "type": "text"},
                {"label": "Bus Termination (Ohms)",  "cell": "E31", "type": "text"}
              ]
            },
            {
              "label": "Power Supply Verified",
              "cell": "C32",
              "sub_questions": [
                {"label": "Measured Voltage (V)",    "cell": "D32", "type": "text"}
              ]
            },
            {
              "label": "Device Tested Online",
              "cell": "C33",
              "sub_questions": [
                {"label": "Test Result / Notes",     "cell": "D33", "type": "multiline"}
              ]
            }
          ]
        },
        {"label": "Connection for Supplies", "type": "section_title"},
        {
          "label": "Is the crane control CanBus connected for LMB and Crane operation?",
          "type": "conditional",
          "required": true,
          "checkbox_cell": "C34",
          "yes_text_label": "Connection Details",
          "yes_text_cell": "D34",
          "yes_text_label2": "Additional Notes (Yes)",
          "yes_text_cell2": "D35",
          "no_text_label": "Reason for Non-Connection",
          "no_text_cell": "E34",
          "no_text_label2": "Additional Notes (No)",
          "no_text_cell2": "E35"
        },
        {"label": "Notes / Comments",       "cell": "B40", "type": "multiline"}
      ]
    }
  ]
